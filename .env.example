# Bingoo Connect 3.0 — Supabase browser configuration
# Copy to .env.local and provide values from Supabase > Connect > React > Vite.
# Only use the publishable (or legacy anon) key in the browser application.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Keep Base44 as the active production backend during the phased migration.
VITE_BACKEND_PROVIDER=base44
