{
  "name": "Analytics",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string",
      "description": "NFC device ID if applicable"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "profile_view",
        "whatsapp_click",
        "phone_click",
        "email_click",
        "instagram_click",
        "facebook_click",
        "tiktok_click",
        "linkedin_click",
        "youtube_click",
        "website_click",
        "payment_click",
        "location_click",
        "save_contact_click"
      ],
      "default": "profile_view"
    },
    "visitor_device": {
      "type": "string"
    },
    "visitor_country": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "description": "Analytics event description or notes",
      "maxLength": 1000
    }
  },
  "required": [
    "profile_id",
    "event_type",
    "created_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "created_by_id": null
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}