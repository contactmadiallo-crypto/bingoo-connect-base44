{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string",
      "description": "User ID of the profile owner"
    },
    "visitor_name": {
      "type": "string"
    },
    "visitor_email": {
      "type": "string"
    },
    "visitor_phone": {
      "type": "string"
    },
    "service_name": {
      "type": "string",
      "description": "Service or appointment type requested"
    },
    "stylist_name": {
      "type": "string",
      "description": "Preferred stylist (salon)"
    },
    "guest_count": {
      "type": "number",
      "description": "Number of guests (restaurant)"
    },
    "case_type": {
      "type": "string",
      "description": "Case type (law firm)"
    },
    "a_number": {
      "type": "string",
      "description": "A-Number (law firm immigration)"
    },
    "case_number": {
      "type": "string",
      "description": "Case number (law firm)"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time_slot": {
      "type": "string",
      "description": "e.g. 09:00"
    },
    "duration": {
      "type": "number",
      "description": "Duration in minutes"
    },
    "notes": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Internal owner notes",
      "maxLength": 2000
    },
    "source": {
      "type": "string",
      "enum": [
        "profile",
        "nfc",
        "qr",
        "direct",
        "referral"
      ],
      "default": "profile"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "accepted",
        "completed",
        "cancelled",
        "canceled",
        "declined",
        "rescheduled",
        "no_show"
      ],
      "default": "pending"
    }
  },
  "required": [
    "profile_id",
    "visitor_name",
    "visitor_email",
    "date",
    "time_slot"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": null
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "data.visitor_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}