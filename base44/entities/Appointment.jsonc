{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string",
      "description": "User ID of the profile owner"
    },
    "visitor_name": {
      "type": "string"
    },
    "visitor_email": {
      "type": "string"
    },
    "visitor_phone": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time_slot": {
      "type": "string",
      "description": "e.g. 09:00"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "accepted",
        "declined",
        "rescheduled",
        "completed",
        "cancelled",
        "canceled"
      ],
      "default": "pending"
    }
  },
  "required": [
    "profile_id",
    "visitor_name",
    "visitor_email",
    "date",
    "time_slot"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": null
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "data.visitor_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}