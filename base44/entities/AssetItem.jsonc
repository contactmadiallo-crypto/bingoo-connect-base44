{
  "name": "AssetItem",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "Owner user ID \u2014 must match authenticated user"
    },
    "profile_id": {
      "type": "string",
      "description": "Optional linked profile"
    },
    "nfc_device_id": {
      "type": "string",
      "description": "Optional linked NFC device for tap-to-identify"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "pet",
        "luggage",
        "bag",
        "keys",
        "equipment",
        "vehicle",
        "other"
      ]
    },
    "name": {
      "type": "string",
      "description": "Asset name e.g. 'MacBook Pro', 'Buddy the Dog'"
    },
    "photo_url": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "lost_mode_enabled": {
      "type": "boolean",
      "default": false
    },
    "finder_message": {
      "type": "string",
      "description": "Message shown to finder when asset is reported lost",
      "maxLength": 1000
    },
    "recovery_instructions": {
      "type": "string",
      "description": "Instructions for the finder on how to return the item",
      "maxLength": 1000
    },
    "safe_contact_preference": {
      "type": "string",
      "enum": [
        "phone",
        "email",
        "whatsapp",
        "none"
      ],
      "default": "phone",
      "description": "Preferred contact method shown to finder"
    },
    "reward_offered": {
      "type": "string",
      "description": "Optional reward text shown publicly to the finder",
      "maxLength": 500
    },
    "public_medical_notes": {
      "type": "string",
      "description": "Pet medical/allergy notes shown publicly only if the owner explicitly fills this. Empty = hidden.",
      "maxLength": 1000
    },
    "public_last_known_context": {
      "type": "string",
      "description": "Last known context for luggage/items shown publicly only if the owner explicitly fills this. Empty = hidden.",
      "maxLength": 1000
    }
  },
  "required": [
    "owner_user_id",
    "asset_type",
    "name"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}