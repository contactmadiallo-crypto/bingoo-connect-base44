{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "Associated order ID"
    },
    "driver_id": {
      "type": "string",
      "description": "Driver ID"
    },
    "driver_name": {
      "type": "string",
      "description": "Driver name"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name"
    },
    "last_message": {
      "type": "string",
      "description": "Last message preview"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last message"
    },
    "unread_count_driver": {
      "type": "number",
      "default": 0,
      "description": "Unread messages for driver"
    },
    "unread_count_customer": {
      "type": "number",
      "default": 0,
      "description": "Unread messages for customer"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "order_id",
    "driver_id",
    "customer_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "data.customer_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}