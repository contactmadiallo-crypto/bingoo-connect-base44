{
  "name": "CustomerLoyalty",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string",
      "description": "Customer email"
    },
    "restaurant_id": {
      "type": "string",
      "description": "Restaurant ID"
    },
    "restaurant_name": {
      "type": "string",
      "description": "Restaurant name for reference"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Total loyalty points"
    },
    "tier": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "bronze",
      "description": "Current loyalty tier"
    },
    "total_spent": {
      "type": "number",
      "default": 0,
      "description": "Total amount spent"
    },
    "total_orders": {
      "type": "number",
      "default": 0,
      "description": "Total number of orders"
    },
    "rewards_redeemed": {
      "type": "number",
      "default": 0,
      "description": "Number of rewards redeemed"
    },
    "description": {
      "type": "string",
      "description": "Loyalty program description or notes",
      "maxLength": 1000
    }
  },
  "required": [
    "customer_email",
    "restaurant_id"
  ]
}