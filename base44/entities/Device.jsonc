{
  "_archived": true,
  "_archive_note": "LEGACY ENTITY \u2014 DO NOT USE. NFCDevice is the source of truth as of 2026-06-20. All 4 active records were migrated to NFCDevice on 2026-06-20. This entity is kept READ-ONLY for rollback purposes only. No frontend code queries or writes to this entity. The only remaining reference is the read-only fallback in functions/getDeviceByCode.js. Delete this entity only after confirming NFCDevice is stable in production.",
  "name": "Device",
  "type": "object",
  "properties": {
    "device_code": {
      "type": "string",
      "description": "Unique activation code e.g. BG-10001"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "card",
        "keychain",
        "bracelet",
        "stand",
        "badge",
        "sticker"
      ],
      "default": "card"
    },
    "activation_status": {
      "type": "string",
      "enum": [
        "available",
        "active",
        "inactive"
      ],
      "default": "available"
    },
    "assigned_user": {
      "type": "string",
      "description": "User ID who activated the device"
    },
    "assigned_profile": {
      "type": "string",
      "description": "Profile ID linked to this device"
    },
    "activation_date": {
      "type": "string",
      "format": "date-time"
    },
    "nickname": {
      "type": "string",
      "description": "Optional user-defined name for the device"
    },
    "description": {
      "type": "string",
      "description": "Device description or notes",
      "maxLength": 1000
    }
  },
  "required": [
    "device_code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}