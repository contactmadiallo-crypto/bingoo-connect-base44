{
  "name": "DocumentWalletItem",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "Owner user ID \u2014 must match authenticated user"
    },
    "profile_id": {
      "type": "string",
      "description": "Optional linked profile"
    },
    "file_url": {
      "type": "string",
      "description": "Uploaded document file URL (front side for ID-type documents)"
    },
    "file_name": {
      "type": "string",
      "description": "Original file name (front side)"
    },
    "file_size": {
      "type": "number",
      "description": "File size in bytes (front side)"
    },
    "file_url_back": {
      "type": "string",
      "description": "Back side file URL for ID-type documents (ID card, passport, SSN, work authorization, visa, license)"
    },
    "file_name_back": {
      "type": "string",
      "description": "Back side file name"
    },
    "file_size_back": {
      "type": "number",
      "description": "Back side file size in bytes"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "id",
        "passport",
        "ssn",
        "work_authorization",
        "visa",
        "certification",
        "license",
        "business_document",
        "contract",
        "tax_document",
        "insurance",
        "medical_record",
        "education",
        "resume",
        "photo",
        "financial",
        "legal",
        "other"
      ],
      "default": "other"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Optional document expiration date"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared"
      ],
      "default": "private",
      "description": "Private by default. Shared only if owner explicitly enables."
    }
  },
  "required": [
    "owner_user_id",
    "file_url",
    "file_name",
    "document_type"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}