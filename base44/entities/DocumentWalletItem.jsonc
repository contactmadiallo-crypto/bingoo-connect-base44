{
  "name": "DocumentWalletItem",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "Owner user ID \u2014 must match authenticated user"
    },
    "profile_id": {
      "type": "string",
      "description": "Optional linked profile"
    },
    "file_url": {
      "type": "string",
      "description": "Uploaded document file URL"
    },
    "file_name": {
      "type": "string",
      "description": "Original file name"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "id",
        "certification",
        "license",
        "business_document",
        "contract",
        "other"
      ],
      "default": "other"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Optional document expiration date"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared"
      ],
      "default": "private",
      "description": "Private by default. Shared only if owner explicitly enables."
    }
  },
  "required": [
    "owner_user_id",
    "file_url",
    "file_name",
    "document_type"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}