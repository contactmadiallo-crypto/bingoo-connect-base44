{
  "name": "Inventory",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string",
      "description": "ID of the restaurant"
    },
    "item_name": {
      "type": "string",
      "description": "Inventory item name"
    },
    "quantity": {
      "type": "number",
      "description": "Current quantity in stock"
    },
    "unit": {
      "type": "string",
      "enum": [
        "kg",
        "g",
        "l",
        "ml",
        "pieces",
        "boxes"
      ],
      "default": "pieces"
    },
    "min_quantity": {
      "type": "number",
      "description": "Minimum stock level"
    },
    "supplier": {
      "type": "string"
    },
    "last_restocked": {
      "type": "string",
      "format": "date"
    },
    "cost_per_unit": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "vegetables",
        "meat",
        "dairy",
        "grains",
        "spices",
        "beverages",
        "packaging",
        "other"
      ],
      "default": "other"
    },
    "description": {
      "type": "string",
      "description": "Inventory item description or notes",
      "maxLength": 1000
    }
  },
  "required": [
    "restaurant_id",
    "item_name",
    "quantity",
    "unit"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}