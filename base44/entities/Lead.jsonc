{
  "name": "Lead",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "profile",
        "nfc",
        "qr",
        "referral",
        "direct",
        "manual",
        "imported"
      ],
      "default": "profile"
    },
    "preferred_contact_method": {
      "type": "string",
      "enum": [
        "WhatsApp",
        "Phone",
        "Email"
      ],
      "default": "WhatsApp"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "won",
        "lost",
        "reviewed",
        "consultation_scheduled",
        "documents_requested",
        "retained",
        "declined",
        "closed"
      ],
      "default": "new"
    },
    "description": {
      "type": "string",
      "description": "Internal CRM notes",
      "maxLength": 5000
    },
    "where_first_met": {
      "type": "string",
      "description": "Location where the connection was first made"
    },
    "when_first_met": {
      "type": "string",
      "format": "date",
      "description": "Date when the connection was first made"
    },
    "event_name": {
      "type": "string",
      "description": "Event where the connection was made"
    },
    "meeting_context": {
      "type": "string",
      "description": "Context of the first meeting"
    },
    "relationship_type": {
      "type": "string",
      "enum": [
        "client",
        "prospect",
        "colleague",
        "business_networking",
        "vendor",
        "friend",
        "partner",
        "other"
      ],
      "default": "prospect"
    },
    "category_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Custom tags for grouping and filtering"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "description": "Next follow-up date"
    },
    "latest_interaction": {
      "type": "string",
      "description": "Summary of latest interaction"
    },
    "timeline_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string",
            "enum": [
              "note",
              "call",
              "email",
              "meeting",
              "whatsapp",
              "other"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "Chronological timeline of interactions with this connection"
    },
    "legal_category": {
      "type": "string",
      "enum": [
        "Immigration",
        "Civil",
        "Criminal"
      ],
      "description": "Law practice category"
    },
    "legal_service": {
      "type": "string",
      "description": "Specific service needed"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "emergency"
      ]
    },
    "preferred_language": {
      "type": "string"
    },
    "preferred_consult_date": {
      "type": "string"
    },
    "assigned_attorney_id": {
      "type": "string"
    },
    "assigned_attorney_name": {
      "type": "string"
    },
    "document_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "immigration_a_number": {
      "type": "string"
    },
    "immigration_uscis_account": {
      "type": "string"
    },
    "immigration_receipt_number": {
      "type": "string"
    },
    "immigration_case_number": {
      "type": "string"
    },
    "immigration_court_date": {
      "type": "string"
    },
    "immigration_court_location": {
      "type": "string"
    },
    "immigration_current_status": {
      "type": "string"
    },
    "immigration_process_type": {
      "type": "string"
    },
    "immigration_country_of_origin": {
      "type": "string"
    },
    "immigration_date_of_entry": {
      "type": "string"
    },
    "immigration_manner_of_entry": {
      "type": "string"
    },
    "immigration_prior_asylum": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        ""
      ]
    },
    "immigration_work_permit_status": {
      "type": "string"
    },
    "immigration_detained": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        ""
      ]
    },
    "immigration_prior_removal": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        ""
      ]
    },
    "immigration_family_petition": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        ""
      ]
    },
    "immigration_deadlines": {
      "type": "string"
    },
    "immigration_notes": {
      "type": "string"
    },
    "civil_matter_type": {
      "type": "string"
    },
    "civil_incident_date": {
      "type": "string"
    },
    "civil_incident_location": {
      "type": "string"
    },
    "civil_opposing_party": {
      "type": "string"
    },
    "civil_case_number": {
      "type": "string"
    },
    "civil_insurance_claim": {
      "type": "string"
    },
    "civil_damages_description": {
      "type": "string"
    },
    "civil_court_date": {
      "type": "string"
    },
    "criminal_charge": {
      "type": "string"
    },
    "criminal_arrest_date": {
      "type": "string"
    },
    "criminal_court_date": {
      "type": "string"
    },
    "criminal_court_location": {
      "type": "string"
    },
    "criminal_docket_number": {
      "type": "string"
    },
    "criminal_precinct": {
      "type": "string"
    },
    "criminal_bail_status": {
      "type": "string"
    },
    "criminal_prior_history": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        ""
      ]
    },
    "criminal_detained": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        ""
      ]
    }
  },
  "required": [
    "profile_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": null
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}