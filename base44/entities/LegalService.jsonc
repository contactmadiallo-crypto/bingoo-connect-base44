{
  "name": "LegalService",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "practice_area_id": {
      "type": "string",
      "description": "Related practice area ID"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "legal_category": {
      "type": "string",
      "enum": [
        "Immigration",
        "Civil",
        "Criminal"
      ],
      "description": "Legal category"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "profile_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}