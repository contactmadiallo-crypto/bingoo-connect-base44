{
  "name": "ManufacturingPartner",
  "type": "object",
  "properties": {
    "partner_code": {
      "type": "string"
    },
    "legal_name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "suspended",
        "inactive"
      ],
      "default": "pending_review"
    },
    "partner_type": {
      "type": "string",
      "enum": [
        "manufacturer",
        "printer",
        "encoder",
        "packager",
        "fulfillment",
        "integrated"
      ],
      "default": "integrated"
    },
    "country_code": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supported_product_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supported_shipping_countries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nfc_encoding": {
      "type": "boolean",
      "default": false
    },
    "uv_printing": {
      "type": "boolean",
      "default": false
    },
    "laser_engraving": {
      "type": "boolean",
      "default": false
    },
    "packaging": {
      "type": "boolean",
      "default": false
    },
    "min_order_quantity": {
      "type": "number",
      "default": 1
    },
    "lead_time_days_min": {
      "type": "number"
    },
    "lead_time_days_max": {
      "type": "number"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "quality_standard": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "maxLength": 3000
    }
  },
  "required": [
    "partner_code",
    "legal_name",
    "country_code",
    "currency"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}