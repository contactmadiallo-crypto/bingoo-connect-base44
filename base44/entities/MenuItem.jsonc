{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string",
      "description": "ID of the restaurant"
    },
    "name": {
      "type": "string",
      "description": "Menu item name"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "appetizers",
        "main_course",
        "daily_special",
        "chef_special",
        "desserts",
        "beverages",
        "sides",
        "salads",
        "soups",
        "breakfast",
        "lunch",
        "dinner"
      ],
      "default": "main_course"
    },
    "image_url": {
      "type": "string"
    },
    "available": {
      "type": "boolean",
      "default": true
    },
    "preparation_time": {
      "type": "number",
      "description": "Time in minutes"
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allergens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "customization_options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "single",
              "multiple"
            ]
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "extra_price": {
                  "type": "number",
                  "default": 0
                }
              }
            }
          }
        }
      },
      "description": "Options for customizing the item"
    }
  },
  "required": [
    "restaurant_id",
    "name",
    "price",
    "category"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.restaurant_id": {
            "$in": [
              "{{user.data.owned_restaurant_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.restaurant_id": {
            "$in": [
              "{{user.data.owned_restaurant_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.restaurant_id": {
            "$in": [
              "{{user.data.owned_restaurant_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}