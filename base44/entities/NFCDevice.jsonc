{
  "name": "NFCDevice",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string",
      "description": "Assigned profile ID (personal or business profile). Optional until activated."
    },
    "device_type": {
      "type": "string",
      "enum": [
        "card",
        "metal_card",
        "keychain",
        "bracelet",
        "stand",
        "badge",
        "sticker",
        "tag"
      ],
      "default": "card",
      "description": "Physical product type \u2014 persists after assignment so a keychain fob stays a keychain fob regardless of what it's assigned to"
    },
    "device_code": {
      "type": "string",
      "description": "Unique identifier printed on device e.g. BG-000001"
    },
    "product_sku": {
      "type": "string",
      "description": "Shop catalog SKU for this physical product (e.g. 'nfc_key_fob', 'nfc_metal_card')"
    },
    "product_name": {
      "type": "string",
      "description": "Human-readable product name e.g. 'NFC Key Fob', 'NFC Metal Card' \u2014 persists after assignment"
    },
    "product_image": {
      "type": "string",
      "description": "Product image URL from the shop catalog \u2014 persists after assignment for consistent display"
    },
    "assigned_asset_id": {
      "type": "string",
      "description": "Direct reference to AssetItem if assigned to an asset (enables efficient recovery routing without reverse lookup)"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "assigned",
        "active",
        "lost",
        "disabled",
        "replaced"
      ],
      "default": "available"
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    },
    "lost_show_phone": {
      "type": "boolean",
      "default": true,
      "description": "Show owner phone number on lost item page"
    },
    "replaced_by_code": {
      "type": "string",
      "description": "Device code of the replacement device"
    },
    "description": {
      "type": "string",
      "description": "Device description or notes",
      "maxLength": 1000
    }
  },
  "required": [
    "device_type",
    "device_code"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}