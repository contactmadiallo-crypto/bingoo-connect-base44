{
  "name": "NFCDevice",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string",
      "description": "Assigned profile ID (optional until activated)"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "card",
        "keychain",
        "bracelet",
        "stand",
        "badge",
        "sticker"
      ],
      "default": "card"
    },
    "device_code": {
      "type": "string",
      "description": "Unique identifier printed on device e.g. BG-000001"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "assigned",
        "active",
        "lost",
        "disabled",
        "replaced"
      ],
      "default": "available"
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    },
    "lost_show_phone": {
      "type": "boolean",
      "default": true,
      "description": "Show owner phone number on lost item page"
    },
    "replaced_by_code": {
      "type": "string",
      "description": "Device code of the replacement device"
    },
    "description": {
      "type": "string",
      "description": "Device description or notes",
      "maxLength": 1000
    }
  },
  "required": [
    "device_type",
    "device_code"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}