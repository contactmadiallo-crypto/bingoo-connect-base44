{
  "name": "NFCDevice",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "card",
        "keychain",
        "bracelet",
        "stand",
        "badge"
      ],
      "default": "card"
    },
    "device_code": {
      "type": "string",
      "description": "Unique identifier printed on device"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "lost"
      ],
      "default": "active"
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "profile_id",
    "device_type",
    "device_code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}