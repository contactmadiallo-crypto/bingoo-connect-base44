{
  "name": "NFCDevice",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "card",
        "keychain",
        "bracelet",
        "stand",
        "badge"
      ],
      "default": "card"
    },
    "device_code": {
      "type": "string",
      "description": "Unique identifier printed on device"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "lost"
      ],
      "default": "active"
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "description": "Device description or notes",
      "maxLength": 1000
    }
  },
  "required": [
    "profile_id",
    "device_type",
    "device_code"
  ]
}