{
  "name": "Notification",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string",
      "description": "Customer email"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message"
    },
    "type": {
      "type": "string",
      "enum": [
        "order_update",
        "special_offer",
        "loyalty_reward",
        "general"
      ],
      "default": "general",
      "description": "Notification type"
    },
    "order_id": {
      "type": "string",
      "description": "Related order ID (if applicable)"
    },
    "restaurant_id": {
      "type": "string",
      "description": "Related restaurant ID (if applicable)"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Whether notification has been read"
    },
    "action_url": {
      "type": "string",
      "description": "URL to navigate to when clicked"
    },
    "description": {
      "type": "string",
      "description": "Notification description or metadata",
      "maxLength": 1000
    }
  },
  "required": [
    "customer_email",
    "title",
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.restaurant_id": {
            "$in": [
              "{{user.data.owned_restaurant_ids}}"
            ]
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}