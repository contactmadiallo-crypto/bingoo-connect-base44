{
  "name": "OfficeLocation",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "hours": {
      "type": "string",
      "description": "Operating hours description"
    },
    "is_primary": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "profile_id",
    "name",
    "address"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}