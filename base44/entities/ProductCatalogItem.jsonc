{
  "name": "ProductCatalogItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "card",
        "metal_card",
        "keychain",
        "bracelet",
        "sticker",
        "tag",
        "stand",
        "badge",
        "bundle"
      ]
    },
    "category": {
      "type": "string",
      "description": "nfc_hardware, bundle, accessory"
    },
    "price": {
      "type": "number",
      "description": "Selling price in USD cents"
    },
    "supplier_cost": {
      "type": "number",
      "description": "Supplier cost in USD cents"
    },
    "margin": {
      "type": "number",
      "description": "Profit margin in USD cents (price - supplier_cost)"
    },
    "image_url": {
      "type": "string"
    },
    "stripe_product_id": {
      "type": "string"
    },
    "stripe_price_id": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_coming_soon": {
      "type": "boolean",
      "default": false
    },
    "stock_count": {
      "type": "number",
      "default": 0
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "product_type",
    "price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}