{
  "name": "Profile",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Unique URL slug"
    },
    "display_name": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "company_logo": {
      "type": "string",
      "description": "URL to company/business logo"
    },
    "bio": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string",
      "description": "URL to profile photo"
    },
    "cover_color": {
      "type": "string",
      "default": "#2563eb"
    },
    "layout": {
      "type": "string",
      "enum": [
        "classic",
        "minimal",
        "dark",
        "bold",
        "split"
      ],
      "default": "classic"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp_number": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "show_location": {
      "type": "boolean",
      "default": true,
      "description": "Whether to display the address on the public profile"
    },
    "facebook_url": {
      "type": "string"
    },
    "instagram_url": {
      "type": "string"
    },
    "tiktok_url": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "youtube_url": {
      "type": "string"
    },
    "payment_link": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "business"
      ],
      "default": "free"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "booking_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Allow visitors to book appointments"
    },
    "booking_slot_duration": {
      "type": "number",
      "default": 30,
      "description": "Slot duration in minutes"
    },
    "booking_restricted_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "If not empty, only these emails can book."
    },
    "business_hours": {
      "type": "object",
      "description": "Weekly schedule keyed by day. Each day: { enabled: bool, start: 'HH:MM', end: 'HH:MM' }",
      "properties": {
        "monday": {
          "type": "object"
        },
        "tuesday": {
          "type": "object"
        },
        "wednesday": {
          "type": "object"
        },
        "thursday": {
          "type": "object"
        },
        "friday": {
          "type": "object"
        },
        "saturday": {
          "type": "object"
        },
        "sunday": {
          "type": "object"
        }
      }
    }
  },
  "required": [
    "username",
    "display_name"
  ]
}