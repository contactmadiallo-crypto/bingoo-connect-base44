{
  "name": "Profile",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Unique URL slug"
    },
    "display_name": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "company_logo": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "cover_photo": {
      "type": "string",
      "description": "Optional background image for cover area"
    },
    "cover_color": {
      "type": "string",
      "default": "#2563eb"
    },
    "avatar_shape": {
      "type": "string",
      "enum": [
        "circle",
        "rounded",
        "squircle",
        "card"
      ],
      "default": "circle"
    },
    "avatar_placement": {
      "type": "string",
      "enum": [
        "center_overlap",
        "lower_center",
        "right_overlap",
        "left_overlap",
        "floating_card",
        "inside_card"
      ],
      "default": "center_overlap"
    },
    "avatar_position": {
      "type": "string",
      "enum": [
        "center top",
        "center",
        "center bottom",
        "left center",
        "right center"
      ],
      "default": "center top"
    },
    "cover_position": {
      "type": "string",
      "enum": [
        "center",
        "top",
        "bottom",
        "left center",
        "right center"
      ],
      "default": "center"
    },
    "qr_color": {
      "type": "string",
      "default": "#1e293b"
    },
    "qr_label": {
      "type": "string",
      "default": "Scan Me"
    },
    "qr_watermark": {
      "type": "boolean",
      "default": false
    },
    "layout": {
      "type": "string",
      "enum": [
        "classic",
        "minimal",
        "dark",
        "bold",
        "split",
        "card",
        "glassmorphic",
        "gradient",
        "neon",
        "retro",
        "magazine",
        "aurora",
        "minimal_dark",
        "pastel",
        "corporate",
        "floating",
        "sunset",
        "ocean",
        "forest",
        "luxury",
        "bubbly",
        "monochrome",
        "cyberpunk",
        "frosted",
        "paper",
        "wave",
        "glass_3d",
        "luxury_gold",
        "executive_corp",
        "neon_tech",
        "modern_law",
        "premium_salon",
        "realtor_luxury",
        "animated_gradient",
        "video_bg",
        "parallax",
        "ny_championship",
        "lions_teranga",
        "portrait",
        "image_hero",
        "glass_card",
        "modern_saas",
        "executive",
        "color_gradient"
      ],
      "default": "classic"
    },
    "profile_layout": {
      "type": "string",
      "enum": [
        "default",
        "ny_championship",
        "lions_teranga"
      ],
      "default": "default"
    },
    "profile_theme": {
      "type": "string",
      "enum": [
        "modern",
        "classic",
        "glassmorphic"
      ],
      "default": "modern"
    },
    "bg_style": {
      "type": "string",
      "enum": [
        "clean",
        "gradient",
        "mesh",
        "night",
        "blur",
        "animated"
      ],
      "default": "clean"
    },
    "button_style": {
      "type": "string",
      "enum": [
        "pill",
        "rounded",
        "sharp",
        "outlined",
        "flat"
      ],
      "default": "pill"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp_number": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "show_location": {
      "type": "boolean",
      "default": true
    },
    "facebook_url": {
      "type": "string"
    },
    "instagram_url": {
      "type": "string"
    },
    "tiktok_url": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "youtube_url": {
      "type": "string"
    },
    "payment_link": {
      "type": "string"
    },
    "zelle_link": {
      "type": "string"
    },
    "zelle_qr": {
      "type": "string"
    },
    "cashapp_link": {
      "type": "string"
    },
    "cashapp_qr": {
      "type": "string"
    },
    "orangemoney_link": {
      "type": "string"
    },
    "orangemoney_qr": {
      "type": "string"
    },
    "wave_link": {
      "type": "string"
    },
    "wave_qr": {
      "type": "string"
    },
    "custom_payments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "qr": {
            "type": "string"
          }
        }
      }
    },
    "custom_links": {
      "type": "array",
      "description": "Custom links with _catalog_id, category, enabled flag",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "_catalog_id": {
            "type": "string",
            "description": "Canonical catalog id e.g. snapchat_url"
          },
          "category": {
            "type": "string",
            "description": "social | contact | payment | business | content"
          }
        }
      }
    },
    "hidden_links": {
      "type": "array",
      "description": "Array of profile field keys the owner has hidden, e.g. ['instagram_url','phone']",
      "items": {
        "type": "string"
      }
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "fr"
      ],
      "default": "en"
    },
    "google_review_url": {
      "type": "string"
    },
    "whatsapp_booking_message": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "professional",
        "pro",
        "salon",
        "restaurant",
        "lawfirm",
        "business",
        "corporate"
      ],
      "default": "free"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "booking_enabled": {
      "type": "boolean",
      "default": false
    },
    "booking_slot_duration": {
      "type": "number",
      "default": 30
    },
    "booking_restricted_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "business_hours": {
      "type": "object",
      "properties": {
        "monday": {
          "type": "object"
        },
        "tuesday": {
          "type": "object"
        },
        "wednesday": {
          "type": "object"
        },
        "thursday": {
          "type": "object"
        },
        "friday": {
          "type": "object"
        },
        "saturday": {
          "type": "object"
        },
        "sunday": {
          "type": "object"
        }
      }
    }
  },
  "required": [
    "username",
    "display_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.is_active": true
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}