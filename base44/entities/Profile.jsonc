{
  "name": "Profile",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Unique URL slug"
    },
    "display_name": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "company_logo": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "cover_color": {
      "type": "string",
      "default": "#2563eb"
    },
    "layout": {
      "type": "string",
      "enum": [
        "classic",
        "minimal",
        "dark",
        "bold",
        "split"
      ],
      "default": "classic"
    },
    "bg_style": {
      "type": "string",
      "enum": [
        "clean",
        "gradient",
        "mesh",
        "night"
      ],
      "default": "clean",
      "description": "Page background atmosphere"
    },
    "button_style": {
      "type": "string",
      "enum": [
        "pill",
        "rounded",
        "sharp"
      ],
      "default": "pill",
      "description": "Button corner style"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp_number": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "show_location": {
      "type": "boolean",
      "default": true
    },
    "facebook_url": {
      "type": "string"
    },
    "instagram_url": {
      "type": "string"
    },
    "tiktok_url": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "youtube_url": {
      "type": "string"
    },
    "payment_link": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "business"
      ],
      "default": "free"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "booking_enabled": {
      "type": "boolean",
      "default": false
    },
    "booking_slot_duration": {
      "type": "number",
      "default": 30
    },
    "booking_restricted_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "business_hours": {
      "type": "object",
      "properties": {
        "monday": {
          "type": "object"
        },
        "tuesday": {
          "type": "object"
        },
        "wednesday": {
          "type": "object"
        },
        "thursday": {
          "type": "object"
        },
        "friday": {
          "type": "object"
        },
        "saturday": {
          "type": "object"
        },
        "sunday": {
          "type": "object"
        }
      }
    }
  },
  "required": [
    "username",
    "display_name"
  ]
}