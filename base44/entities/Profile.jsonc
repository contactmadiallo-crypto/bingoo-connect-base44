{
  "name": "Profile",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Unique URL slug"
    },
    "display_name": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "company_logo": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "cover_photo": {
      "type": "string",
      "description": "Optional background image for cover area"
    },
    "cover_color": {
      "type": "string",
      "default": "#2563eb"
    },
    "layout": {
      "type": "string",
      "enum": [
        "classic",
        "minimal",
        "dark",
        "bold",
        "split",
        "card",
        "glassmorphic",
        "gradient",
        "neon",
        "retro",
        "magazine",
        "aurora",
        "minimal_dark",
        "pastel",
        "corporate",
        "floating",
        "sunset",
        "ocean",
        "forest",
        "luxury",
        "bubbly",
        "monochrome",
        "cyberpunk",
        "frosted",
        "paper",
        "wave"
      ],
      "default": "classic"
    },
    "profile_theme": {
      "type": "string",
      "enum": [
        "modern",
        "classic",
        "glassmorphic"
      ],
      "default": "modern",
      "description": "Overall visual theme for the public profile"
    },
    "bg_style": {
      "type": "string",
      "enum": [
        "clean",
        "gradient",
        "mesh",
        "night",
        "blur",
        "animated"
      ],
      "default": "clean",
      "description": "Page background atmosphere"
    },
    "button_style": {
      "type": "string",
      "enum": [
        "pill",
        "rounded",
        "sharp",
        "outlined",
        "flat"
      ],
      "default": "pill",
      "description": "Button corner style"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp_number": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "show_location": {
      "type": "boolean",
      "default": true
    },
    "facebook_url": {
      "type": "string"
    },
    "instagram_url": {
      "type": "string"
    },
    "tiktok_url": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "youtube_url": {
      "type": "string"
    },
    "payment_link": {
      "type": "string"
    },
    "zelle_link": {
      "type": "string"
    },
    "cashapp_link": {
      "type": "string"
    },
    "orangemoney_link": {
      "type": "string"
    },
    "wave_link": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "business"
      ],
      "default": "free"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "booking_enabled": {
      "type": "boolean",
      "default": false
    },
    "booking_slot_duration": {
      "type": "number",
      "default": 30
    },
    "booking_restricted_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "business_hours": {
      "type": "object",
      "properties": {
        "monday": {
          "type": "object"
        },
        "tuesday": {
          "type": "object"
        },
        "wednesday": {
          "type": "object"
        },
        "thursday": {
          "type": "object"
        },
        "friday": {
          "type": "object"
        },
        "saturday": {
          "type": "object"
        },
        "sunday": {
          "type": "object"
        }
      }
    }
  },
  "required": [
    "username",
    "display_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.is_active": true
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}