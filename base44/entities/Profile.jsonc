{
  "name": "Profile",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Unique URL slug"
    },
    "display_name": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "company_logo": {
      "type": "string",
      "description": "URL to company/business logo"
    },
    "bio": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string",
      "description": "URL to profile photo"
    },
    "cover_color": {
      "type": "string",
      "default": "#2563eb"
    },
    "layout": {
      "type": "string",
      "enum": [
        "classic",
        "minimal",
        "dark",
        "bold",
        "split"
      ],
      "default": "classic",
      "description": "Visual layout style for the public profile"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp_number": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "facebook_url": {
      "type": "string"
    },
    "instagram_url": {
      "type": "string"
    },
    "tiktok_url": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "youtube_url": {
      "type": "string"
    },
    "payment_link": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "business"
      ],
      "default": "free"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "username",
    "display_name"
  ]
}