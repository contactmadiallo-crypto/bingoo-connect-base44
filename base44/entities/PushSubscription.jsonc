{
  "name": "PushSubscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user ID \u2014 must match the authenticated user"
    },
    "transport": {
      "type": "string",
      "enum": [
        "webpush"
      ],
      "default": "webpush",
      "description": "Browser Web Push delivery transport"
    },
    "endpoint": {
      "type": "string",
      "description": "Web Push endpoint URL"
    },
    "p256dh": {
      "type": "string",
      "description": "Web Push P-256 ECDH public key"
    },
    "auth": {
      "type": "string",
      "description": "Web Push authentication secret"
    },
    "device_label": {
      "type": "string",
      "description": "Friendly device label"
    },
    "browser": {
      "type": "string",
      "description": "Browser name for web subscriptions"
    },
    "platform": {
      "type": "string",
      "description": "Platform/OS"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}