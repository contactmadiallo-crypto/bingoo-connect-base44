{
  "name": "RestaurantAccess",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string",
      "description": "Linked Restaurant id"
    },
    "owner_user_id": {
      "type": "string",
      "description": "Owner user ID (resolved from Restaurant.owner_email at creation)"
    },
    "owner_email": {
      "type": "string",
      "description": "Owner email snapshot (matches Restaurant.owner_email)"
    },
    "access_status": {
      "type": "string",
      "enum": [
        "active",
        "trial_locked",
        "archived"
      ],
      "default": "active"
    },
    "is_primary": {
      "type": "boolean",
      "default": false
    },
    "subscription_id": {
      "type": "string",
      "description": "Resource-specific entitlement link \u2014 the Subscription record governing THIS restaurant."
    },
    "plan_name": {
      "type": "string",
      "enum": [
        "free",
        "professional",
        "pro",
        "salon",
        "restaurant",
        "lawfirm",
        "business",
        "corporate"
      ],
      "description": "Effective plan snapshot governing this restaurant."
    },
    "entitlement_id": {
      "type": "string",
      "description": "Snapshot of the active PlanEntitlement id governing this restaurant."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this access's entitlement expires."
    },
    "access_source": {
      "type": "string",
      "enum": [
        "stripe",
        "trial",
        "admin_override",
        "legacy"
      ],
      "default": "legacy"
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "lock_reason": {
      "type": "string"
    }
  },
  "required": [
    "restaurant_id",
    "owner_user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}