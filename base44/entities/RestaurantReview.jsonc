{
  "name": "RestaurantReview",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string",
      "description": "Restaurant ID"
    },
    "restaurant_name": {
      "type": "string",
      "description": "Restaurant name"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name"
    },
    "order_id": {
      "type": "string",
      "description": "Related order ID"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Rating from 1 to 5 stars"
    },
    "comment": {
      "type": "string",
      "description": "Review comment"
    },
    "food_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Food quality rating"
    },
    "service_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Service rating"
    },
    "delivery_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Delivery rating"
    },
    "restaurant_response": {
      "type": "string",
      "description": "Restaurant's response to the review"
    },
    "response_date": {
      "type": "string",
      "format": "date-time",
      "description": "When restaurant responded"
    },
    "helpful_count": {
      "type": "number",
      "default": 0,
      "description": "Number of users who found this helpful"
    }
  },
  "required": [
    "restaurant_id",
    "customer_email",
    "rating"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.restaurant_id": {
            "$in": [
              "{{user.data.owned_restaurant_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}