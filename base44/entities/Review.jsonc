{
  "name": "Review",
  "type": "object",
  "properties": {
    "menu_item_id": {
      "type": "string",
      "description": "ID of the menu item being reviewed"
    },
    "menu_item_name": {
      "type": "string",
      "description": "Name of the menu item"
    },
    "restaurant_id": {
      "type": "string",
      "description": "ID of the restaurant"
    },
    "restaurant_name": {
      "type": "string",
      "description": "Name of the restaurant"
    },
    "customer_name": {
      "type": "string",
      "description": "Name of the customer"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Rating from 1 to 5 stars"
    },
    "comment": {
      "type": "string",
      "description": "Customer's review comment"
    },
    "description": {
      "type": "string",
      "description": "Review description or summary",
      "maxLength": 1000
    }
  },
  "required": [
    "menu_item_id",
    "restaurant_id",
    "rating"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}",
      "data.customer_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.restaurant_id": {
            "$in": [
              "{{user.data.owned_restaurant_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}