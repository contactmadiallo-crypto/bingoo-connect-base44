{
  "name": "Shipment",
  "type": "object",
  "properties": {
    "shipment_number": {
      "type": "string"
    },
    "shop_order_id": {
      "type": "string"
    },
    "production_job_id": {
      "type": "string"
    },
    "partner_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "label_created",
        "picked_up",
        "in_transit",
        "customs",
        "out_for_delivery",
        "delivered",
        "exception",
        "returned",
        "cancelled"
      ],
      "default": "draft"
    },
    "origin_country_code": {
      "type": "string"
    },
    "destination_country_code": {
      "type": "string"
    },
    "carrier": {
      "type": "string"
    },
    "service_level": {
      "type": "string"
    },
    "tracking_number": {
      "type": "string"
    },
    "tracking_url": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "shipping_cost": {
      "type": "number"
    },
    "declared_value": {
      "type": "number"
    },
    "duties_taxes": {
      "type": "number"
    },
    "duties_paid_by": {
      "type": "string",
      "enum": [
        "sender",
        "recipient",
        "unknown"
      ],
      "default": "unknown"
    },
    "incoterm": {
      "type": "string"
    },
    "customs_description": {
      "type": "string"
    },
    "country_of_origin": {
      "type": "string"
    },
    "weight_grams": {
      "type": "number"
    },
    "length_mm": {
      "type": "number"
    },
    "width_mm": {
      "type": "number"
    },
    "height_mm": {
      "type": "number"
    },
    "estimated_delivery": {
      "type": "string",
      "format": "date-time"
    },
    "shipped_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_event_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "shipment_number",
    "shop_order_id",
    "destination_country_code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}