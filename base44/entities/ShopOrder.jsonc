{
  "name": "ShopOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "shipping_address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "order_notes": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "price_id": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "customDesign": {
            "type": "object",
            "description": "Custom NFC design configuration from Design Studio",
            "properties": {
              "productType": {
                "type": "string"
              },
              "cardColor": {
                "type": "string"
              },
              "accentColor": {
                "type": "string"
              },
              "nameText": {
                "type": "string"
              },
              "holderName": {
                "type": "string"
              },
              "roleText": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "website": {
                "type": "string"
              },
              "assignProfileId": {
                "type": "string"
              },
              "finish": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              },
              "removeBranding": {
                "type": "boolean"
              },
              "brandPattern": {
                "type": "object"
              },
              "logoUrl": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "manufacturing_items": {
      "type": "array",
      "description": "Manufacturing items with activation codes, generated after payment",
      "items": {
        "type": "object",
        "properties": {
          "product_type": {
            "type": "string"
          },
          "product_sku": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "finish": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "company_name": {
            "type": "string"
          },
          "holder_name": {
            "type": "string"
          },
          "role_position": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "website": {
            "type": "string"
          },
          "assign_profile_id": {
            "type": "string"
          },
          "logo_url": {
            "type": "string"
          },
          "card_color": {
            "type": "string"
          },
          "accent_color": {
            "type": "string"
          },
          "remove_branding": {
            "type": "boolean"
          },
          "brand_pattern": {
            "type": "object"
          },
          "design_data": {
            "type": "object"
          },
          "activation_codes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "qr_url": {
                  "type": "string"
                },
                "device_id": {
                  "type": "string"
                }
              }
            }
          },
          "manufacturing_status": {
            "type": "string",
            "enum": [
              "pending",
              "in_production",
              "printed",
              "shipped",
              "activated"
            ],
            "default": "pending"
          }
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "description": "Client-supplied key used by createShopCheckout to dedupe repeated checkout attempts against the same order."
    },
    "subtotal": {
      "type": "number"
    },
    "shipping_cost": {
      "type": "number",
      "default": 5
    },
    "total": {
      "type": "number"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "unpaid"
    },
    "fulfillment_status": {
      "type": "string",
      "enum": [
        "processing",
        "ready_to_ship",
        "shipped",
        "delivered",
        "cancelled"
      ],
      "default": "processing"
    },
    "manufacturing_status": {
      "type": "string",
      "enum": [
        "pending",
        "device_allocated",
        "in_production",
        "programmed",
        "ready_to_ship",
        "shipped"
      ],
      "default": "pending"
    },
    "carrier": {
      "type": "string"
    },
    "tracking_number": {
      "type": "string"
    },
    "tracking_url": {
      "type": "string"
    },
    "estimated_delivery": {
      "type": "string",
      "format": "date-time"
    },
    "shipped_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmation_email_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "shipped_email_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "stripe_payment_intent": {
      "type": "string"
    },
    "assigned_device_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string",
      "description": "Order description or notes",
      "maxLength": 1000
    },
    "production_spec_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ProductionSpecification records generated for this paid order."
    },
    "production_job_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ProductionJob records generated for this paid order."
    },
    "production_backbone_status": {
      "type": "string",
      "enum": [
        "pending",
        "generated",
        "error"
      ],
      "default": "pending"
    },
    "production_backbone_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "shipping_zone": {
      "type": "string",
      "description": "Server-resolved fulfillment shipping zone."
    },
    "shipping_service": {
      "type": "string",
      "description": "Server-resolved shipping service level."
    },
    "shipping_currency": {
      "type": "string",
      "default": "USD"
    },
    "shipping_eta_min_days": {
      "type": "number"
    },
    "shipping_eta_max_days": {
      "type": "number"
    },
    "duties_terms": {
      "type": "string",
      "description": "Customs duty/tax treatment, e.g. domestic or DAP."
    }
  },
  "required": [
    "customer_name",
    "customer_email",
    "items"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}