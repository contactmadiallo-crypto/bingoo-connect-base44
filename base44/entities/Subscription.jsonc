{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "professional",
        "pro",
        "salon",
        "restaurant",
        "lawfirm",
        "business",
        "corporate"
      ],
      "default": "free"
    },
    "status": {
      "type": "string",
      "enum": [
        "free",
        "active",
        "trialing",
        "past_due",
        "canceled"
      ],
      "default": "free"
    },
    "plan_source": {
      "type": "string",
      "enum": [
        "stripe",
        "admin_override"
      ],
      "default": "stripe",
      "description": "Where this record's entitlement comes from. 'admin_override' means an admin manually granted this plan without a real Stripe subscription."
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "description": "Subscription description or notes",
      "maxLength": 1000
    }
  },
  "required": [
    "customer_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": null
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}