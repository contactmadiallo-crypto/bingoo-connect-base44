{
  "name": "Table",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string",
      "description": "ID of the restaurant"
    },
    "table_number": {
      "type": "string"
    },
    "capacity": {
      "type": "number",
      "description": "Number of seats"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "occupied",
        "reserved"
      ],
      "default": "available"
    },
    "qr_code_url": {
      "type": "string",
      "description": "QR code for table menu"
    },
    "location": {
      "type": "string",
      "description": "Table location in restaurant"
    },
    "description": {
      "type": "string",
      "description": "Table description or notes",
      "maxLength": 1000
    }
  },
  "required": [
    "restaurant_id",
    "table_number",
    "capacity"
  ]
}