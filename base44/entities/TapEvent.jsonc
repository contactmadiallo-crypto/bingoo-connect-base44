{
  "name": "TapEvent",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "link_id": {
      "type": "string",
      "description": "set if a link was clicked"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "tap",
        "link_click",
        "whatsapp_click",
        "email_click",
        "phone_click"
      ],
      "default": "tap"
    },
    "tapped_at": {
      "type": "string",
      "format": "date-time"
    },
    "country": {
      "type": "string"
    },
    "device": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Event description or notes",
      "maxLength": 1000
    }
  },
  "required": [
    "profile_id",
    "event_type",
    "tapped_at"
  ],
  "rls": {
    "create": {
      "created_by_id": null
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}