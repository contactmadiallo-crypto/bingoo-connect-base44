{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string",
      "description": "Owner profile ID"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "description": "Job title / role e.g. Attorney, Hair Stylist, Manager"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "photo": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "practice_areas": {
      "type": "string",
      "description": "Comma-separated practice areas (law firm) or specialties"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "profile_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}