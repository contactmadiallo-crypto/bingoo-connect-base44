{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "description": "e.g. Partner, Associate, Managing Attorney"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "photo": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "education": {
      "type": "string"
    },
    "experience": {
      "type": "string"
    },
    "awards": {
      "type": "string"
    },
    "bar_states": {
      "type": "string",
      "description": "Bar admitted states, comma-separated"
    },
    "languages": {
      "type": "string",
      "description": "Languages spoken, comma-separated"
    },
    "practice_categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Immigration",
          "Civil",
          "Criminal"
        ]
      },
      "description": "Law practice categories"
    },
    "practice_areas": {
      "type": "string",
      "description": "Specific services, comma-separated"
    },
    "consultation_fee": {
      "type": "string"
    },
    "availability": {
      "type": "string"
    },
    "office_address": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "profile_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.profile_id": {
            "$in": [
              "{{user.data.owned_profile_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}