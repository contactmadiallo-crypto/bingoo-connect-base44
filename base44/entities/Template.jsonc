{
  "name": "Template",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name"
    },
    "type": {
      "type": "string",
      "enum": [
        "project",
        "work",
        "checklist"
      ],
      "description": "Type of template"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "description": "Template data structure"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Whether template is available to all users"
    }
  },
  "required": [
    "name",
    "type",
    "data"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.is_public": true
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}