{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "business_owner",
        "team_member"
      ],
      "default": "user",
      "description": "User role on the platform"
    },
    "owned_profile_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Profile IDs owned by this user"
    },
    "assigned_business_id": {
      "type": "string",
      "description": "For team_member: the business profile ID they are assigned to"
    }
  }
}