{
  "type": "object",
  "name": "User",
  "title": "User",
  "properties": {
    "email": {
      "type": "string",
      "description": "The email of the user"
    },
    "full_name": {
      "type": "string",
      "description": "The full name of the user"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "business_owner",
        "team_member"
      ],
      "default": "user",
      "description": "User role on the platform"
    },
    "owned_profile_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Profile IDs owned by this user"
    },
    "assigned_business_id": {
      "type": "string",
      "description": "For team_member: the business profile ID they are assigned to"
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}