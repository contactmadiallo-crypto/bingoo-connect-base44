{
  "type": "object",
  "name": "User",
  "title": "User",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "business_owner",
        "team_member"
      ],
      "default": "user",
      "description": "User role on the platform"
    },
    "owned_profile_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Profile IDs owned by this user"
    },
    "assigned_business_id": {
      "type": "string",
      "description": "For team_member: the business profile ID they are assigned to"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "individual",
        "business"
      ],
      "description": "Whether this is an individual or business account. Null/missing = legacy individual."
    },
    "business_type": {
      "type": "string",
      "enum": [
        "law_firm",
        "salon",
        "restaurant",
        "agency",
        "retail",
        "corporate"
      ],
      "description": "Business category. Only meaningful when account_type = business."
    },
    "default_profile_id": {
      "type": "string",
      "description": "The profile ID auto-selected when the user has more than one profile. Set via the My Profiles hub."
    },
    "profile_order_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Owner-defined display order of profile IDs in the My Profiles dashboard. Profiles not listed are appended by created date."
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "en",
        "fr"
      ],
      "description": "User-selected Bingoo interface language. Synced across web and mobile."
    },
    "preferred_region": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country/region code used for regional defaults, shipping, and currency presentation."
    }
  },
  "required": [
    "owned_profile_ids",
    "assigned_business_id",
    "account_type",
    "business_type",
    "default_profile_id",
    "profile_order_ids"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}