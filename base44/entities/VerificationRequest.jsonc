{
  "name": "VerificationRequest",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "verification_type": {
      "type": "string",
      "enum": [
        "identity",
        "business",
        "both"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "document_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "idempotency_key": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer_id": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "profile_id",
    "owner_user_id",
    "verification_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}