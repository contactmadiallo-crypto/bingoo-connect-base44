{
  "name": "Auto-Index New & Updated Profiles",
  "description": "Notifies Google Indexing API (or IndexNow fallback) within minutes whenever a public profile is created or updated, ensuring fast crawl discovery.",
  "trigger": {
    "condition": "${ ((.trigger.data.is_active == true) and (.trigger.data.username != null and .trigger.data.username != \"\" and .trigger.data.username != [] and .trigger.data.username != {})) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Profile"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_index_new_updated_profiles",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyGoogleIndex",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyGoogleIndex"
  }
}